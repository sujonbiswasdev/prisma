generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  watchList Movie[] @relation("UserWatchList")
  review Review[]
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  @@map("users")
}
model Movie{
  id String @id @default(uuid())
  name String
  releaseDate String
  director String
  rating String?
  genre String
  watchListUser User[] @relation("UserWatchList")
  review Review[]
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  @@map("movies")
}

model Review{
  id String @id @default(ulid())
  comment String
  movie Movie @relation(fields: [movieId],references: [id])
  movieId String
  user User @relation(fields: [userId],references: [id])
  userId String
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  @@map("reviews")
}